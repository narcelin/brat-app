{
  "name": "brat-app",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "test": "vitest run",
    "typecheck": "tsc --noEmit",
    "test:watch": "vitest",
    "test:integration": "node --env-file=.env.test.local ./node_modules/.bin/vitest run --config vitest.integration.config.ts",
    "db:apply": "node --env-file=.env.development.local db/apply.mjs db/schema.sql db/seed.sql db/dev-branch.sql",
    "db:apply:test": "node --env-file=.env.test.local db/apply.mjs db/schema.sql db/test-branch.sql"
  },
  "dependencies": {
    "@clerk/nextjs": "^7.9.1",
    "@neondatabase/serverless": "^1.1.0",
    "@vercel/blob": "^2.8.0",
    "next": "16.3.4",
    "react": "19.2.8",
    "react-dom": "19.2.8"
  },
  "devDependencies": {
    "@types/node": "^20",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "sharp": "^0.35.4",
    "typescript": "^5",
    "vitest": "^4.1.11"
  }
}
